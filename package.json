{
  "name": "interrogation-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run compile && vite",
    "compile": "tsx scripts/compile.ts vault dist-data",
    "compile:fixture": "tsx scripts/compile.ts fixtures/itd/vault fixtures/itd/dist-data",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile=work/test-results.json",
    "build": "npm run compile && npm run compile:fixtures && tsc --noEmit && vite build",
    "verify": "tsx scripts/verify.ts",
    "compile:fixtures": "tsx scripts/build-fixtures.ts",
    "audit": "tsx scripts/audit.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
